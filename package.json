{
  "name": "j2fz",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript-first bidirectional JavaScript bridge for Fozzy ABI libraries",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test dist/tests/**/*.test.js"
  },
  "keywords": [
    "fozzy",
    "ffi",
    "typescript",
    "bindings",
    "native"
  ],
  "license": "MIT",
  "dependencies": {
    "koffi": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}

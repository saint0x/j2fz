{
  "name": "j2fz",
  "version": "0.1.0",
  "private": false,
  "description": "TypeScript-first bidirectional JavaScript bridge for Fozzy ABI libraries",
  "repository": {
    "type": "git",
    "url": "https://github.com/saint0x/j2fz.git"
  },
  "homepage": "https://github.com/saint0x/j2fz",
  "type": "module",
  "exports": {
    ".": "./dist/src/index.js",
    "./runtime/raw": "./dist/src/runtime/raw.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "bench": "npm run build && node --expose-gc dist/bench/runtime-bench.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test dist/tests/**/*.test.js"
  },
  "keywords": [
    "fozzy",
    "ffi",
    "typescript",
    "bindings",
    "native"
  ],
  "license": "MIT",
  "dependencies": {
    "koffi": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}

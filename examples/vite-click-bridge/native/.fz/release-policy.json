{
  "documentation": {
    "implementationBacked": true,
    "surfaces": [
      {
        "name": "language-policy",
        "output": ".fz/language-policy.json + .fz/language-policy.md",
        "source": "compiler syntax-freeze and profile metadata"
      },
      {
        "name": "native-runtime-contracts",
        "output": ".fz/native-runtime-contracts.json + .fz/native-runtime-contracts.md",
        "source": "native runtime contract table"
      },
      {
        "name": "release-policy",
        "output": ".fz/release-policy.json + .fz/release-policy.md",
        "source": "compiler release-policy metadata"
      },
      {
        "name": "diagnostic-catalog",
        "output": "fz explain catalog --json",
        "source": "diagnostic catalog metadata"
      },
      {
        "name": "stability-dashboard",
        "output": "artifacts/stability_dashboard.json",
        "source": "exit criteria and perf-source metadata"
      }
    ]
  },
  "errorModel": {
    "cliMainReturn": "i32",
    "errorClassType": "ErrorClass",
    "errorClasses": [
      {
        "description": "boundary and IO failures at runtime or service edges",
        "mapsFromErrorCodes": [
          "Io"
        ],
        "name": "transport"
      },
      {
        "description": "invalid input and decode failures",
        "mapsFromErrorCodes": [
          "InvalidInput"
        ],
        "name": "parse"
      },
      {
        "description": "deadline and wait exhaustion",
        "mapsFromErrorCodes": [
          "Timeout"
        ],
        "name": "timeout"
      },
      {
        "description": "capability, conflict, and safety-policy violations",
        "mapsFromErrorCodes": [
          "Conflict"
        ],
        "name": "policy"
      },
      {
        "description": "not-found and internal runtime/compiler failure states",
        "mapsFromErrorCodes": [
          "NotFound",
          "Internal"
        ],
        "name": "internal"
      }
    ],
    "exitStatusType": "ExitStatus",
    "httpHandlersReturn": "i32_after_writing_response",
    "runtimeErrorType": "RuntimeError",
    "runtimeInternalsReturn": "typed_status_or_result",
    "serviceFunctionsReturn": "Result<T, Error>",
    "statusType": "Status"
  },
  "performance": {
    "benchmarkArtifact": "artifacts/bench_corelibs_rust_vs_fzy.json",
    "stabilityDashboardCommand": "fz stability-dashboard",
    "summaryCommand": "fz perf [--artifact artifacts/bench_corelibs_rust_vs_fzy.json]",
    "workloads": [
      {
        "description": "CLI startup latency",
        "name": "cli_startup"
      },
      {
        "description": "HTTP request throughput",
        "name": "http_throughput"
      },
      {
        "description": "JSON construction and parsing",
        "name": "json_build_parse"
      },
      {
        "description": "process spawn and wait",
        "name": "proc_spawn_wait"
      },
      {
        "description": "stream reading throughput",
        "name": "stream_reading"
      },
      {
        "description": "task-group execution",
        "name": "task_group_execution"
      },
      {
        "description": "compiler parse, lower, and build time",
        "name": "compiler_parse_lower_build"
      },
      {
        "description": "native binary size",
        "name": "native_binary_size"
      }
    ]
  },
  "releaseGating": {
    "backendParityRequired": true,
    "compatibilitySetRequired": true,
    "diagnosticCatalogStabilityRequired": true,
    "traceReplayCompatibilityRequired": true
  },
  "schemaVersion": "fozzylang.release_policy.v1",
  "versions": {
    "diagnosticCatalogVersion": "fozzylang.diagnostic_catalog.v1",
    "languageVersion": "fozzylang.language.v1",
    "manifestSchemaVersion": "fozzy.run_manifest.v1",
    "nativeImportTableVersion": "fozzylang.native_runtime_contracts.v1",
    "runtimeAbiVersion": "fozzylang.runtime.v0",
    "traceSchemaVersion": "fozzy-trace.v4"
  }
}